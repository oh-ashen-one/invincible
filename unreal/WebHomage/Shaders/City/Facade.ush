      float shd = boxAA(TEXPASS, fx, cx - 0.5f * acW, cx + 0.5f * acW + 0.1f, aw) * boxAA(TEXPASS, fy, wy0 - 0.45f, wy0, ah) * (1.0f - hit);
      float drip = boxAA(TEXPASS, fx, cx + 0.12f, cx + 0.2f, aw) * step(fy, wy0) * (1.0f - smoothstep(0.0f, 2.2f, wy0 - fy));
      r.alb *= (1.0f - 0.45f * shd * (1.0f - smoothstep(0.0f, 0.45f, wy0 - fy))) * (1.0f - 0.3f * drip);
    }
  }
  // far LOD (skyline): exactly box-filtered window pattern (pbox) instead of a flat average: floor bands, deco pier
  // lines, spandrel stripes and mullion grids stay readable on distant towers and fade to the true mean (no moire)
  if (lod > 0.0f) {
    float wf = 1.15f; // (skyline r4) wider box filter: kills the micro-grid moire seen from altitude
    float cxw = pbox(TEXPASS, ux, bw, wx0, wx0 + ww, aw * wf);
    float cyw = pbox(TEXPASS, yy, fh, wy0, wy0 + wh, ah * wf);
    float cov = cxw * cyw * valid;
    float3 roomAvg = Texture2DSampleLevel(tInterior, tInteriorSampler, fl2(float2((gmod(tile, 4.0f) + 0.5f) / 4.0f,1.0f - (floor(tile / 4.0f) + 0.5f) / 4.0f)), 9.0f).rgb;
    Surf a = (Surf)0;
    a.n = float3(0,0,1); a.metal = 0.0f;
    if (curtain) {
      float capx = 1.0f - pbox(TEXPASS, fx, bw, cw, bw - cw, aw * wf);
      float capy = 1.0f - pbox(TEXPASS, yy, fh, cw, fh - cw, ah * wf);
      float cap = clamp(capx + capy - capx * capy, 0.0f, 1.0f);
      float3 glc = gt * ((lowIron ? 0.13f : 0.05f) + 0.03f * cellR); // (skyline r7) low-iron glass body tone (as near LOD)
      glc *= 0.75f + 0.5f * zR; // (skyline r12) per-zone tone (as near LOD)
      if (vX.y > 2.5f) glc = float3(0.05f,0.052f,0.055f); // (street r11) louvre band
      glc = lerp(glc, float3(0.3f,0.3f,0.28f), 0.75f * cBl * cBl * lerp(0.5f, 1.0f, wv)); // (skyline r8) blinds (pane-average of the near LOD)
      float3 capc = capC * (0.9f + 0.2f * nz2.r);
      float vis = cyw * valid;
      a.alb = lerp(lerp(spC, glc, vis), capc, cap);
      a.rough = lerp(lerp(spGl > 0.5f ? 0.1f : 0.38f, 0.06f, vis), 0.42f, cap);
      a.metal = cap * 0.85f + (1.0f - cap) * (1.0f - vis) * (spGl > 0.5f ? 0.3f : 0.5f);
      gGlass = lerp(gGlass, (1.0f - cap) * lerp(spGl * 0.8f, 1.0f, vis), lod);
      a.emis = roomAvg * uInteriorGain * 0.25f * vis * (1.0f - cap) * (0.6f + 0.8f * lit);
      gCovN = vis * (1.0f - cap) * (1.0f - 0.6f * cBl); // (night)
    } else {
      float3 avgGlass = float3(0.035f,0.038f,0.042f);
      { // (skyline r8) per-window variation in the far LOD: blinds / curtains (same cellR rule as the near LOD), lit vs
        // dark rooms, pane tone; fades to the mean once a window cell is sub-1.5f px
        float thr = deco ? 0.86f : (pOK ? 0.8f : 0.55f), bf = cellR > thr ? min(1.0f, (cellR - thr) * 1.8f) : 0.0f; // (street r10) zOK: fewer blinds
        float3 bcF = resid ? lerp(float3(0.85f,0.8f,0.7f), float3(0.6f,0.35f,0.3f), step(0.8f, cellR2)) : float3(0.82f,0.82f,0.8f);
        float3 wvC = avgGlass * (0.55f + 0.9f * cellR2) + roomAvg * 0.08f * lit;
        wvC = lerp(wvC, bcF * 0.55f, bf);
        float meanB = deco ? 0.02f : (pOK ? 0.06f : 0.2f); // (street r10) masonry: fewer blinds -> darker window mean
        avgGlass = lerp(lerp(avgGlass, bcF * 0.55f, meanB), wvC, wv);
      }
      float3 wallC = o.alb;
      if (deco) { // recessed dark spandrels stacked between the windows: vertical pier lines
        float3 spd = lerp(float3(0.075f,0.078f,0.082f), float3(0.2f,0.2f,0.19f), 0.35f * frac(seed * 3.3f)) * (0.85f + 0.3f * nz2.r);
        wallC = lerp(o.alb, lerp(spd, avgGlass, cyw), cxw * valid);
        a.alb = wallC;
        a.metal = 0.2f * cxw * valid * (1.0f - cyw);
      } else {
        a.alb = lerp(wallC, avgGlass, cov);
      }
      a.alb *= 1.0f - 0.1f * cxw * valid * (1.0f - cyw); // reveals / sills shading
      a.rough = lerp(o.rough, 0.12f, cov);
      gGlass = lerp(gGlass, cov, lod);
      a.emis = (roomAvg * 0.25f * (0.4f + 1.2f * lit) + float3(0.03f,0.036f,0.045f)) * uInteriorGain * cov * (pOK ? 0.7f : (deco ? 0.5f : 1.0f)); // (textures r4) pOK 0.45f -> 0.7f // (street r10) darker masonry windows; (skyline r11) deco too
      gCovN = cov * (pOK ? 0.85f : 1.0f); // (night)
    }
    r.alb = lerp(r.alb, a.alb, lod); r.alb *= lerp(float3(1.0f, 1.0f, 1.0f), float3(1.12f, 1.02f, 0.86f), smoothstep(0.4f, 1.0f, lod)); r.rough = lerp(r.rough, a.rough, lod); r.metal = lerp(r.metal, a.metal, lod);
    r.n = normalize(lerp(r.n, a.n, lod)); r.emis = lerp(r.emis, a.emis, lod);
  }
  // (night) lit windows replace the day emission (whose fake sky-reflection floor + x4.5 night exposure turned every
  // window into a lit pane). Near: the room seen through the glass (interior mapping with lit = nOn: ceiling lights,
  // back wall), backlit blinds / curtains glow dimmer; dark rooms are nearly black glass. Far: exact glass coverage x
  // this window's state, then the floor / building mean once windows / floors get sub-pixel (no shimmer).
  if (uNightK > 0.0f) {
    const float nG = 0.5f; // lit-room radiance scale (the night exposure is x4.5)
    float glassM = open * inG * (1.0f - frame) * (1.0f - gAcN) * (1.0f - capW);
    float bc2 = clamp(gBlN + gCurN, 0.0f, 1.0f);
    // backlit blinds / curtains: slats + a glow gradient toward the lamp side, not a flat card
    float slatN = 0.3f + 0.12f * step(0.5f, frac(gp.y * 25.0f)) + 0.18f * clamp(gq.y, 0.0f, 1.0f);
    float3 nearE = nOn > 0.5f ? (room * (1.0f - bc2) + ((float3)(slatN)) * gBlN + ((float3)(0.2f * (0.8f + 0.2f * sin(gp.x * 38.0f)))) * gCurN) * nCol : room * 0.012f;
    float3 perW = nOn > 0.5f ? nCol : ((float3)(0.012f));
    float3 kM = lerp(perW, lerp(nFlM, nBdM, smoothstep(0.35f, 0.8f, ah / fh)), 1.0f - wv);
    float3 nE = lerp(nearE * glassM, gCovN * 0.42f * kM, lod) * nG;
    r.emis = lerp(r.emis, nE, uNightK);
    // (night) the lit room lights its own opening: jambs / head (the faked reveal inside the opening outline), the sill
    // and the frame get ~20-30 % of the window radiance, a short falloff onto the sill course / wall under the opening
    // (the rect lights of the provider sit on the wall plane: they light what stands in front, not this faked relief)
    if (nOn > 0.5f && lod < 1.0f) {
      float sillM = inWx * boxAA(TEXPASS, fy, wy0 - 0.45f, wy0 + 0.02f, ah) * (0.35f + 0.65f * smoothstep(wy0 - 0.45f, wy0, fy)) * valid;
      float halo = inWx * boxAA(TEXPASS, fy, wy0 - 1.2f, wy0 + wh + 0.3f, ah) * valid * 0.04f;
      float revM = open * (1.0f - inG) + 0.6f * frame * open;
      r.emis += r.alb * nCol * nG * 0.25f * (revM + 0.8f * sillM + halo) * (1.0f - lod) * uNightK; // ~20 % of the window radiance
    }
  }
  if (uNightK > 0.0f && abs(vWN.y) > 0.6f) r.emis *= 1.0f - uNightK; // (lighting2 r3) no 'windows' on roofs / flat tops (far-shore roofs glowed as a pale band at night)
  // (skyline r4) large-scale facade breakup on towers (not deco: those carry piers + tier cornices): a louvred
  // mechanical floor every M floors, a louvred plant band under the top of every mass (reads as a mechanical crown /
  // penthouse at each setback) and, on curtain walls, a heavier vertical pier / fin every K bays. All terms are
  // box-filtered (pbox) so they survive at any distance and never shimmer.
  if (!deco && topY - gH > 36.0f) {
    float hM = frac(seed * 2.93f + 0.41f), hK = frac(seed * 6.17f + 0.23f);
    float M = 9.0f + floor(hM * 5.0f) * 4.0f; // 9..25 floors
    float mech = pbox(TEXPASS, yy + 0.5f * fh, M * fh, (M - 1.0f) * fh, M * fh, ah * 1.3f) * step(0.5f, hK) * step(3.0f * fh, topY - gH - yy) * (curtain && lowIron ? 0.0f : 1.0f); // (skyline r5) 50 % of towers (was 72 %)
    float crownH = (curtain ? 1.0f : 1.4f) * fh + (hM > 0.55f ? fh : 0.0f);
    float crownB = boxAA(TEXPASS, yy, topY - gH - crownH, topY - gH + 2.0f, ah) * step(0.2f, frac(seed * 3.17f)) * ((curtain || ribbon || topY - gH > 70.0f) ? 1.0f : 0.0f) /* (skyline r9) not on masonry mid-rises (bands under cornices) */ * (curtain && lowIron ? 0.0f : 1.0f); // (skyline r6) no plant band per tier on the low-iron supertalls (One WTC read as striped)
    float band = max(mech, crownB) * boxAA(TEXPASS, ux, -0.05f, usable + 0.05f, aw) * step(0.0f, yy);
    if (zOK) band = 0.0f; // (street r9) masonry walls: no louvred plant floors mid-shaft (read as translucent stripes on brick); the cap zone crowns them
    float pierM = 0.0f, finN = 0.0f;
    bool roundT = gHs < -0.015f && gHs > -0.03f; // (skyline r9) round tower tiers (FacadeBuilder.cyl wrap)
    if ((curtain && hK > 0.45f) || roundT) { // vertical pier fin every K bays (0.3f-0.5f m), lit / shaded edge
      float K = roundT ? 1.0f + floor(frac(seed * 9.31f) * 2.0f) : 2.0f + floor(frac(seed * 9.31f) * 4.0f), pw = (roundT ? 0.34f : 0.3f) + 0.2f * frac(seed * 1.77f);
      pierM = pbox(TEXPASS, ux + 0.5f * pw, K * bw, 0.0f, pw, aw * 1.3f) * valid;
      float ft = gmod(ux + 0.5f * pw, K * bw) / pw; // across the fin: rounded profile -> lit / shaded edges (near range)
      finN = step(ft, 1.0f) * (ft * 2.0f - 1.0f) * 0.85f * (1.0f - lod);
    }
    if (band > 0.001f || pierM > 0.001f) {
      float sl = pbox(TEXPASS, yy, 0.32f, 0.0f, 0.13f, ah * 1.2f); // louvre blades: converge to their mean when sub-pixel
      float3 louv = (curtain ? lerp(capC, float3(0.2f,0.21f,0.22f), 0.78f) : lerp(o.alb * 0.55f, float3(0.2f,0.21f,0.22f), 0.6f)) * (1.0f - 0.45f * sl) * (0.9f + 0.2f * nz2.g);
      // louvre floors keep the pier / mullion rhythm (thin stiles every bay)
      float stile = 1.0f - pbox(TEXPASS, fx, bw, cw + 0.03f, bw - cw - 0.03f, aw * 1.3f);
      louv = lerp(louv, curtain ? capC : o.alb * 1.05f, stile * 0.8f);
      r.alb = lerp(r.alb, louv, band); r.rough = lerp(r.rough, 0.55f, band); r.metal = lerp(r.metal, curtain ? 0.6f : 0.2f, band);
      r.n = normalize(lerp(r.n, float3(0.0f,-0.3f * (1.0f - lod),1.0f), band)); // (skyline r9) blades slope down-out: no sky-blue glint from the street r.emis *= 1.0f - band; gGlass *= 1.0f - band;
      r.emis *= 1.0f - band * uNightK; // (night) the line above only comments this out: no lit rooms behind louvre floors
      float3 pc = lerp(capC, float3(0.62f,0.63f,0.63f), step(0.62f, frac(seed * 4.39f + 0.5f)) * 0.4f) * (0.85f + 0.3f * nz2.r);
      if (roundT && !curtain) pc = o.alb * float3(1.1f,1.09f,1.07f); // (skyline r9) cast-stone / concrete fins on masonry drums
      float pm = pierM * (1.0f - band);
      r.n = normalize(lerp(r.n, float3(finN,0.0f,1.0f), pm * (1.0f - lod)));
      r.alb = lerp(r.alb, pc, pm); r.rough = lerp(r.rough, 0.38f, pm); r.metal = lerp(r.metal, 0.8f, pm); r.emis *= 1.0f - pm; gGlass *= 1.0f - pm;
    }
  }
  if (curtain) r.n = normalize(r.n + float3(gWob,0.0f) * clamp(gGlass, 0.0f, 1.0f));
  // (skyline r12) critic: 'no ambient occlusion at setback ledges'. Contact shade at the foot of every set-back tier
  // (the terrace roof + parapet occlude the lower wall), plus a long soft falloff; box-filtered by construction (no tex)
  if (tierY > 1.0f) {
    float dyT = vFac.y - tierY;
    float aoT = 0.36f * (1.0f - smoothstep(0.0f, 4.5f, dyT)) + 0.14f * (1.0f - smoothstep(0.0f, 20.0f, dyT));
    r.alb *= 1.0f - aoT; r.emis *= 1.0f - 0.6f * aoT; gGlass *= 1.0f - 0.5f * aoT;
    gAoT = aoT; // (night)
  }
  return r;
}

// ---- UE entry. fac = UV0; F = (UV1, UV2); S = (UV3, UV4); W = (UV5, UV6); X7 = UV7 (resid + 2 lintel + 16 glass, depth);
// tint = vertex colour * 2. wpos / cam in UE cm, wn = UE world vertex normal. P = (InteriorGain, ShopGain, NightK, DnTime).
// Returns the albedo; outputs roughness, metallic, UE world-space normal, emissive, glass weight + F0 colour.
float3 CityFacade(TEXDECL, float2 fac, float4 F, float4 S, float4 W, float2 X7, float3 tint, float3 wposU, float3 wnU, float3 camU,
                  float4 P, float2 fragXY, out float rough, out float metal, out float3 nU, out float3 emis, out float glass, out float3 f0)
{
  vFac = fac; vF = F; vS = S; vW = W;
  float xp = floor(X7.x + 0.5);
  vX = float4(gmod(xp, 2.0), gmod(floor(xp / 2.0), 8.0), floor(xp / 16.0), X7.y);
  vTint = tint; vWPos = CityU2B(wposU) * 0.01; vWN = normalize(CityU2B(wnU)); gCamPos = CityU2B(camU) * 0.01; gFragCoord = fragXY;
  uInteriorGain = P.x; uShopGain = P.y; uNightK = P.z; uDnTime = P.w;
  Surf FS = facade(TEXPASS);
  float3 Nw = normalize(vWN);
  float3 Tw = Nw.y > 0.5 ? float3(1.0, 0.0, 0.0) : (Nw.y < -0.5 ? float3(1.0, 0.0, 0.0) : normalize(cross(float3(0.0, 1.0, 0.0), Nw)));
  float3 Bw = Nw.y > 0.5 ? float3(0.0, 0.0, -1.0) : (Nw.y < -0.5 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0));
  float3 nb = normalize(Tw * FS.n.x + Bw * FS.n.y + Nw * FS.n.z);
  nU = CityB2U(nb);
  rough = FS.rough; metal = FS.metal; emis = FS.emis;
  // (author's night, facade.js material patch outside FRAG_DECL) crown floodlights: the flood function runs unchanged, gain x NightK
  if (uNightK > 0.0) emis += FS.alb / max(1.0 - gAoT, 0.4) * (1.0 - 0.6 * FS.metal) * crownFlood(TEXPASS, vWPos, normalize(vWN)) * uNightK;
  float cg = saturate(gGlass);
  // browser: specularColor -> gF0 * gSpecTint on glass, old sash glass dimmer (x (1 - 0.4 gSash)) and per-window gSashV
  f0 = gF0 * gSpecTint * (1.0 - 0.4 * gSash) * lerp(1.0, gSashV, gSash);
  glass = cg;
  return FS.alb;
}
// (r07, CITY-SPEC C1) albedo soft knee: light stone and pale window-panel / spandrel base colours are compressed above 'knee' (luma of the linear albedo)
// so a sunlit facade crop keeps <= 1.5 % of pixels above Y 204; albedo below the knee (shadowed and dark facades) is untouched.
float3 CityAlbCap(float3 a, float knee, float slope)
{
  float L = dot(a, float3(0.2126, 0.7152, 0.0722));
  float Lc = L <= knee ? L : knee + (L - knee) * slope;
  return a * (Lc / max(L, 1e-4));
}
