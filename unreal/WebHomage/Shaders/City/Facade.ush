        r.alb = lerp(r.alb, ac.alb, k); r.rough = lerp(r.rough, ac.rough, k); r.metal = lerp(r.metal, ac.metal, k);
        r.n = normalize(lerp(r.n, ac.n, k)); r.emis *= 1.0f - k; gGlass *= 1.0f - k;
        gAcN = k; // (night)
      }
