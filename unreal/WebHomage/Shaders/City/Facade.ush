      float parge = boxAA(TEXPASS, y, -1.0f, hL, ah) * boxAA(TEXPASS, u, 0.4f, faceW - 0.4f, aw);
      float3 pc = float3(0.56f,0.54f,0.5f) * (0.8f + 0.35f * st.b) * (0.85f + 0.2f * nz2.g);
      float flash = boxAA(TEXPASS, y, hL - 0.08f, hL + 0.05f, ah) * boxAA(TEXPASS, u, 0.4f, faceW - 0.4f, aw);
      o.alb = lerp(o.alb, pc, parge * (0.75f + 0.25f * st.r)); o.rough = lerp(o.rough, 0.92f, parge);
      o.n = normalize(lerp(o.n, float3(0.0f,0.0f,1.0f), parge * 0.8f));
      o.alb = lerp(o.alb, float3(0.08f,0.08f,0.085f), flash); o.metal = lerp(o.metal, 0.4f, flash);
    }
    if (r2 > 0.5f && faceW > 9.0f && topY > 16.0f) { // ghost sign painted on the brick, high on the wall
      float y1 = topY - 2.0f - 2.0f * r1, u0 = faceW * 0.12f, u1 = faceW * 0.88f, y0 = y1 - min(min(8.0f, (topY - 6.0f) * 0.35f), (u1 - u0) * 0.25f); // (billboards r3) one 4:1 sign cell, unstretched
      float inS = boxAA(TEXPASS, u, u0, u1, aw) * boxAA(TEXPASS, y, y0, y1, ah);
      if (inS > 0.0f) {
        float2 suv = float2((u - u0) / (u1 - u0),(y - y0) / (y1 - y0));
        float row = floor(r3 * 16.0f), col = floor(r1 * 4.0f); // (billboards r3) one cell (was: the whole 4-cell atlas row squeezed in)
        float2 suv2 = float2((col + clamp(suv.x, 0.01f, 0.99f)) / 4.0f,1.0f - (row + 1.0f - clamp(suv.y, 0.04f, 0.96f)) / 16.0f);
        float3 sc = Texture2DSampleGrad(tSigns, tSignsSampler, fl2(suv2), fd2(gDx / (u1 - u0) / 4.0f), fd2(gDy / (y1 - y0) / 16.0f)).rgb;
        float3 bd = Texture2DSampleGrad(tSigns, tSignsSampler, fl2(suv2), fd2(float2(0.06f,0.0f)), fd2(float2(0.0f,0.03f))).rgb; // blurred cell ~ board colour
        float lum = dot(sc, float3(0.3f,0.55f,0.15f)), let = smoothstep(0.1f, 0.24f, abs(lum - dot(bd, float3(0.3f,0.55f,0.15f))));
        float3 paint = lerp(float3(0.2f,0.19f,0.2f), float3(0.74f,0.68f,0.55f), let); // (billboards r3) cream lettering, the dark board mostly weathered off
        float wear = smoothstep(0.25f, 0.75f, st.r + 0.3f * nz2.b) * (1.0f - 0.6f * (1.0f - smoothstep(0.0f, 0.3f, frac(vFac.y / 0.075f)))); // paint gone at mortar / worn
        o.alb = lerp(o.alb, paint * (0.9f + 0.2f * nz.g), inS * lerp(0.12f, 0.5f, let) * wear);
      }
    }
    // (street r11) critic: 'a completely flat, windowless brown slab'. Tall exposed lot-line walls get a few columns of
    // small lot-line windows (dark glass, stone sill, some bricked-up) above the old neighbour's roof line
    if (r1 > 0.3f && topY > 22.0f && faceW > 8.0f) {
      float pfh = 3.2f, pfl = floor(y / pfh), pfy = y - pfl * pfh;
      float nC = faceW > 24.0f ? 4.0f : (faceW > 14.0f ? 3.0f : 2.0f), cwid = faceW / nC;
      float ci = floor(u / cwid), cu = u - (ci + 0.5f) * cwid;
      float hMin = 8.0f + 10.0f * r2;
      float colOn = step(0.28f, frac(sin(ci * 12.9f + seed * 3.1f) * 437.5f)) * step(hMin, y) * step(y, topY - 2.5f);
      float wm = boxAA(TEXPASS, cu, -0.55f, 0.55f, aw) * boxAA(TEXPASS, pfy, 0.9f, 2.5f, ah) * colOn;
      float brk = step(0.8f, frac(sin(ci * 7.1f + pfl * 3.7f + seed) * 911.3f));             // bricked-up
      float sillM = boxAA(TEXPASS, cu, -0.7f, 0.7f, aw) * boxAA(TEXPASS, pfy, 0.75f, 0.9f, ah) * colOn;
      float3 wc = lerp(float3(0.035f,0.04f,0.045f) * (0.8f + 0.5f * frac(pfl * 0.37f + ci)), o.alb * 0.8f, brk);
      o.alb = lerp(o.alb, wc, wm); o.rough = lerp(o.rough, lerp(0.2f, o.rough, brk), wm); o.metal = lerp(o.metal, 0.0f, wm);
      o.alb = lerp(o.alb, float3(0.62f,0.6f,0.55f) * (0.85f + 0.2f * nz2.r), sillM); o.n = normalize(lerp(o.n, float3(0.0f,0.6f,1.0f), sillM));
    }
    return o;
  }
  if (style < 0.5f) return o;

  bool curtain = abs(style - 2.0f) < 0.5f;
  bool ribbon = abs(style - 3.0f) < 0.5f;
  bool deco = abs(style - 4.0f) < 0.5f;

  // ----------------------------------------------------------- storefront zone
  if (y < gH && gHs > 0.0f) {
    float nb2 = max(1.0f, floor(faceW / 6.5f + 0.5f));
    float bw2 = faceW / nb2;
    float bi2 = floor(u / bw2);
    float fx2 = u - bi2 * bw2;
    float rnd = fh1(TEXPASS, float2(bi2 + seed * 13.1f,seed * 7.7f + faceW));
    Surf base = wallSurf(TEXPASS, float2(u,vFac.y), Lb, Lb > 5.5f && Lb < 6.5f ? ((float3)(1.0f)) : tint * 0.0f + ((float3)(1.0f)));
    float pier = 0.35f;
    float signY0 = gH - 1.55f, signY1 = gH - 0.55f;
    float inner = boxAA(TEXPASS, fx2, pier, bw2 - pier, aw);
    o = base;
    if (inner <= 0.0f) return o;
    Surf s = (Surf)0;
    float glassY0 = 0.55f;
    if (y > signY1) { // cornice band
      s = base; s.alb *= 1.12f; s.n = float3(0.0f,0.45f,0.9f);
    } else if (y > signY0) { // sign band
      float row = floor(fh1(TEXPASS, float2(rnd * 91.0f,seed)) * 16.0f);
      float2 suv = float2((fx2 - pier) / (bw2 - 2.0f * pier),(y - signY0) / (signY1 - signY0));
      float3 sc = Texture2DSampleLevel(tSigns, tSignsSampler, fl2(float2(suv.x,1.0f - (row + 1.0f - suv.y) / 16.0f)), clamp(log2(max(aw * 1024.0f / (bw2 - 2.0f * pier), ah * 128.0f / 1.0f)) - 2.0f, 0.0f, 9.0f)).rgb;
      s.alb = sc; s.rough = 0.45f; s.metal = 0.0f; s.n = float3(0.0f,0.0f,1.0f); s.emis = sc * 0.25f * uShopGain;
#ifdef FAR_NIGHT
      s.emis *= 1.0f - 0.8f * uNightK; // (night)
#endif
      if (rnd > 0.8f) { s = base; s.alb *= 0.8f; } // no sign
    } else if (y < glassY0) { // bulkhead
      s = base; s.alb *= 0.55f; s.rough = 0.4f;
    } else {
      float shutter = step(0.78f, rnd);
      float gx = fx2 - pier, gw = bw2 - 2.0f * pier;
      if (shutter > 0.5f && y > signY0 - 0.24f) { // shutter box (coil housing) closes the shutter up to the sign band
        float lip = boxAA(TEXPASS, y, signY0 - 0.24f, signY0 - 0.2f, ah);
        s.alb = float3(0.3f,0.31f,0.32f) * (0.85f + 0.15f * nz.b) * (1.0f - 0.35f * lip); s.rough = 0.45f; s.metal = 0.6f;
        s.n = normalize(float3(0.0f,0.35f * (1.0f - lip) - 0.6f * lip,1.0f)); s.emis = ((float3)(0.0f));
      } else if (shutter > 0.5f) {
        // roll-down shutter: 7.5f cm curved slats with dark interlock grooves; the relief fades out once a slat spans
        // < ~3 px (no stripe aliasing), bottom rail, grime rising from the pavement
        float P = 0.075f, sy = y / P, fs = frac(sy);
        float amp = 1.0f - smoothstep(0.012f, 0.03f, ah);
        float slope = cos(fs * 6.2831f) * amp;                               // convex slat profile
        float groove = (1.0f - boxAA(TEXPASS, fs, 0.08f, 0.92f, ah / P)) * amp;           // interlock gap
        float rail = boxAA(TEXPASS, y, glassY0 - 0.02f, glassY0 + 0.1f, ah);
        float3 sc = float3(0.58f,0.59f,0.6f) * (0.85f + 0.15f * nz.b) * (1.0f - 0.45f * groove) * lerp(0.6f, 1.0f, smoothstep(0.0f, 1.2f, y));
        float graf = smoothstep(0.58f, 0.66f, Texture2DSampleGrad(tNoise, tNoiseSampler, fl2(float2(u,y) / 3.0f + seed), fd2(gDx / 3.0f), fd2(gDy / 3.0f)).g) * step(y, 2.2f);
        sc = lerp(sc, float3(0.25f + 0.5f * rnd,0.2f,0.6f - 0.4f * rnd), graf * 0.7f);
        sc = lerp(sc, float3(0.2f,0.21f,0.22f), rail);
        s.alb = sc; s.rough = 0.5f + 0.2f * groove; s.metal = 0.5f * (1.0f - graf); s.n = normalize(float3(0.0f,slope * 0.45f,1.0f)); s.emis = ((float3)(0.0f));
      } else {
        // recessed shop glass with mullions
        float d = 0.18f;
        float2 gp = float2(gx,y) + float2(-Vt.x,-Vt.y) / Vt.z * d;
        float inG = boxAA(TEXPASS, gp.x, 0.0f, gw, aw) * boxAA(TEXPASS, gp.y, glassY0, signY0, ah);
        float nm = max(1.0f, floor(gw / 1.8f + 0.5f)); float mw = gw / nm;
        float mx = gmod(gp.x, mw);
        float mull = max(1.0f - boxAA(TEXPASS, mx, 0.05f, mw - 0.05f, aw), 1.0f - boxAA(TEXPASS, gp.y, glassY0 + 0.06f, signY0 - 0.06f, ah));
        mull = max(mull, 1.0f - boxAA(TEXPASS, abs(gp.y - (signY0 - 0.9f)), 0.04f, 9.0f, ah));
        float door = step(rnd, 0.5f) * boxAA(TEXPASS, gp.x, 0.4f, 1.5f, aw) * step(gp.y, 2.6f);
        bool wideR = uNightK > 0.35f; // (night) one room behind the whole shop window (the per-mullion 1.8f m rooms read as flat tan corridor walls)
        gRoomWrap = gw; float3 room = interior(TEXPASS, float2(gp.x + 12.0f * mw,gp.y - glassY0), dirIn, gw + 24.0f * mw, signY0 - glassY0 + 0.6f, 5.0f,
                             12.0f + floor(frac(sin(dot(float2(bi2 + seed * 13.1f, faceW * 0.37f + seed * 3.3f), float2(127.1f, 311.7f))) * 43758.5453f) * 7.0f), 1.0f, 1.0f);
        float F = 0.04f + 0.96f * pow(1.0f - Vt.z, 5.0f);
        Surf gl = (Surf)0; gl.alb = ((float3)(0.02f)); gl.rough = 0.04f; gl.metal = 0.0f; gl.n = float3(0.0f,0.0f,1.0f);
        gl.emis = room * uShopGain * (1.0f - F);
        // (night) warm lit shop interiors, not blown panels: x0.3 against the x4.5 night exposure, 3000-3500 K tint, and
        // ~20 % of the open (unshuttered) shops closed for the night (dim security light). Same rule as registerShop()
        // (JS), which lights the sidewalk with a rect light per frontage.
        if (uNightK > 0.0f) gl.emis *= lerp(((float3)(1.0f)), frac(rnd * 37.1f) < 0.2f ? float3(0.03f,0.032f,0.036f) : float3(0.24f,0.2f,0.15f), uNightK); // (critic r3) -35 %
#ifdef FAR_NIGHT
        gl.emis *= 1.0f - 0.8f * uNightK; // (night) far shores: 1-3 km of lit shop bands summed into a warm tan haze band
#endif
        Surf fr = (Surf)0; fr.alb = rnd > 0.4f ? float3(0.05f,0.05f,0.055f) : float3(0.35f,0.28f,0.18f); fr.rough = 0.35f; fr.metal = 0.8f; fr.n = float3(0,0,1); fr.emis = ((float3)(0.0f));
        float fm = max(mull, door * 0.0f);
        Surf rv = base; rv.alb *= 0.6f; rv.n = float3(gp.x < 0.0f ? 1.0f : (gp.x > gw ? -1.0f : 0.0f),gp.y < glassY0 ? 1.0f : (gp.y > signY0 ? -1.0f : 0.0f),0.3f);
        rv.n = normalize(rv.n);
        s.alb = lerp(gl.alb, fr.alb, fm); s.rough = lerp(gl.rough, fr.rough, fm); s.metal = lerp(gl.metal, fr.metal, fm);
        s.n = float3(0,0,1); s.emis = gl.emis * (1.0f - fm);
        // reveal where the glass point falls outside the opening
        s.alb = lerp(rv.alb, s.alb, inG); s.rough = lerp(rv.rough, s.rough, inG); s.metal = lerp(0.0f, s.metal, inG);
        s.n = normalize(lerp(rv.n, s.n, inG)); s.emis *= inG;
        gGlass = inG * (1.0f - fm); gF0 = 0.07f;
      }
    }
    o.alb = lerp(o.alb, s.alb, inner); o.rough = lerp(o.rough, s.rough, inner); o.metal = lerp(o.metal, s.metal, inner);
    o.n = normalize(lerp(o.n, s.n, inner)); o.emis = s.emis * inner;
    gGlass *= inner;
    return o;
  }

  // ----------------------------------------------------------- upper floors
  float fh = vF.x;
  float yy = y - gH;
  float fl = floor(yy / fh);
  float fy = yy - fl * fh;
  float margin = vW.w;
  float usable = faceW - 2.0f * margin;
  float nb = max(1.0f, floor(usable / vF.y + 0.5f));
  float bw = usable / nb;
  float ux = u - margin;
  float bi = floor(ux / bw);
  float fx = ux - bi * bw;
  float ww = bw * vF.z;
  float wh = fh * vF.w;
  float wx0 = (bw - ww) * 0.5f;
  float wy0 = (fh - wh) * (curtain ? 0.72f : 0.42f);
  // ==================== (street r9) STREET-LEVEL ZONING of punched masonry facades (street agent, additive) ====================
  // critic: 'one tiled brick texture with identical window modules, no base / belt courses / cornice zone / bays / AC units'.
  // Classic NYC tripartite facade: a rusticated stone BASE (1-2 floors over the shops), a brick SHAFT broken into bays
  // (pilasters every K windows, paired sash windows on some buildings, continuous sill courses every N floors, stone
  // quoins), a CAP zone (1-2 floors, stone or brick with arched heads) under the cornice, belt courses between zones.
  // All per-building choices hash the building seed; buildings.js emits real projecting belt ledges at the same heights.
  bool zOK = !curtain && !ribbon && !deco && style < 1.5f && Lw < 3.5f; // masonry (brick / limestone) walls only
  bool pOK = !curtain && !ribbon && !deco && style < 1.5f; // (street r10) every punched wall: dark window treatment
  float zH1 = frac(seed * 2.37f + 0.11f), zH2 = frac(seed * 4.73f + 0.59f), zH3 = frac(seed * 8.19f + 0.27f), zH4 = frac(seed * 1.61f + 0.83f);
  float zNf = floor((topY - gH) / fh + 0.01f);
  float zBase = (zOK && zNf >= 5.0f) ? 1.0f + step(0.55f, zH1) * step(9.0f, zNf) : 0.0f;
  float zCap = (zOK && zNf >= 6.0f) ? 1.0f + step(0.6f, zH2) * step(11.0f, zNf) : 0.0f;
  float zCapY = (zNf - zCap) * fh;                       // yy where the cap zone starts
  bool zInBase = zOK && fl < zBase;
  bool zInCap = zOK && zCap > 0.0f && yy >= zCapY;
  bool zPaired = zOK && bw > 2.15f && zH4 < 0.42f && !zInBase && !zInCap;
  float zBayK = 3.0f + floor(zH4 * 3.0f);                    // pilaster every K windows
  float zH5 = frac(seed * 3.31f + 0.47f);                     // (street r11) mid-shaft belt courses every zMidK floors
  float zMidK = (pOK && zNf - zBase - zCap >= 11.0f) ? 6.0f + floor(zH5 * 3.0f) : 0.0f; // zOK: + projecting ledges (buildings.js); other punched walls: shader belt only
  bool zMidF = zMidK > 0.5f && !zInCap && fl > zBase + 0.5f && gmod(fl - zBase, zMidK) < 0.5f && fl <= zNf - zCap - 3.0f; // floor just above a mid belt
  if (zPaired) { // two sash windows share one masonry opening group, a narrow brick mullion between them
    float hb = bw * 0.5f; float bi2 = floor(ux / hb); float par = gmod(bi2, 2.0f);
    bw = hb; bi = bi2; fx = ux - bi2 * hb;
    ww = min(hb * 0.8f, ww * 0.62f); wx0 = par < 0.5f ? hb - ww - 0.09f : 0.09f;
  }
  if (zInBase) { wh = min(fh - 0.5f, wh * 1.14f); wy0 = (fh - wh) * 0.5f; }
  if (zInCap && zH2 > 0.3f) { wh = min(fh - 0.45f, wh * 1.08f); wy0 = (fh - wh) * 0.4f; }
  // ==================== end street r9 zoning (window geometry); wall treatment below ====================
  float valid = boxAA(TEXPASS, ux, 0.0f, usable, aw) * boxAA(TEXPASS, yy, 0.0f, topY - gH - (curtain ? 0.2f : 1.2f), ah);
  float cellR = fh1(TEXPASS, float2(bi + seed * 3.7f,fl + seed * 1.3f));
  float cellR2 = fh1(TEXPASS, float2(fl * 1.7f + seed,bi * 2.3f - seed));
  float lod = clamp(max(aw / bw, ah / fh) * 3.0f - 0.6f, 0.0f, 1.0f);
  // (skyline r8) per-window variation survives into the far LOD while a window cell still spans >= ~1.5f px
  // (critic: 'one tiled window pattern per tower, no per-window light / blind variation, reads as wallpaper')
  float wv = 1.0f - smoothstep(0.5f, 0.9f, max(aw / bw, ah / fh));
  // (night) window occupancy (refs/night esb_perch_night): a sparse, irregular lerp. Office / deco towers light whole
  // floors or one tenant's bay group (fluorescent / neutral LED / some warm), most floors dark with a few stray lights;
  // homes / masonry a sparse per-window scatter of warm tungsten at very varied brightness (curtains, lamps deep in the
  // room), a few blue TV glows. nOn / nCol: this window; nFlM / nBdM: the floor's / building's expected emission factor
  // (used once windows / floors go sub-pixel: the far city averages out instead of shimmering)
  float nOn = 0.0f; float3 nCol = ((float3)(1.0f)), nFlM = ((float3)(0.0f)), nBdM = ((float3)(0.0f));
  if (uNightK > 0.0f) {
    float busy = 0.5f + frac(seed * 3.77f + 0.21f);                        // per-building activity 0.5f .. 1.5f
    // integer hashes (exactly reproducible in JS: the window-light provider emits light for the same lit windows); the
    // bay index ignores the paired-sash split (a pair shares one bay: both lit or both dark)
    uint sdI = uint(floor(seed * 1000.0f + 0.5f)), flI = uint(int(fl)), biI = uint(int(floor(ux / (usable / nb))));
    float flR = nh01(TEXPASS, nh3(flI, sdI, 11u));
    float wR = nh01(TEXPASS, nh3(biI, flI, sdI + 23u)), wR2 = nh01(TEXPASS, nh3(biI, flI, sdI + 57u));
    if (curtain || ribbon || deco) {
      float pF = (deco ? 0.42f : 0.36f) * busy, pP = 0.18f * busy; // (critic r1) office towers ~45-60 % lit          // floor fully lit / one tenant's bays lit
      uint gBI = biI / uint(3.0f + floor(frac(seed * 5.3f) * 6.0f));
      float gR = nh01(TEXPASS, nh3(gBI, flI, sdI + 91u));
      float full = step(flR, pF), part = (1.0f - full) * step(flR, pF + pP);
      float fOn = full > 0.5f ? 0.66f : (part > 0.5f ? 0.4f : 0.03f);
      nOn = step(wR, full > 0.5f ? (gR < 0.18f ? 0.1f : 0.8f) : (part > 0.5f ? step(gR, 0.45f) * 0.85f : 0.03f)); // full floors: an odd dark bay group
      float fq = frac(flR * 53.7f);
      float3 fc = (fq < 0.5f ? float3(0.8f,0.92f,1.0f) : (fq < 0.84f ? float3(1.0f,0.93f,0.8f) : float3(1.0f,0.74f,0.48f))) * (deco ? 1.0f : 0.7f); // half cool-white LED, the rest neutral / warm // (night) office floors: bright but not blown
      if (deco) fc = lerp(fc, float3(1.0f,0.9f,0.74f), 0.35f);                // deco towers: warmer (ESB ref)
      float flB = 0.55f + 0.45f * frac(flR * 29.3f); // per-floor brightness
      nCol = fc * flB * (0.6f + 0.4f * wR2);
      nFlM = fc * flB * fOn * 0.8f;
      nBdM = float3(0.93f,0.9f,0.84f) * (pF * 0.66f + pP * 0.4f + 0.03f) * 0.62f;
    } else {
      float pw = 0.25f * busy * (0.6f + 0.8f * frac(flR * 3.3f));
      nOn = step(wR, pw);
      float tv = step(0.9f, wR2);
      nCol = tv > 0.5f ? float3(0.42f,0.56f,1.0f) * 0.4f : lerp(float3(1.0f,0.58f,0.28f), float3(1.0f,0.8f,0.56f), frac(wR2 * 7.9f)) * lerp(0.12f, 1.0f, pow(frac(wR2 * 3.7f), 1.4f));
      nFlM = float3(1.0f,0.68f,0.4f) * pw * 0.5f;
      nBdM = float3(1.0f,0.68f,0.4f) * 0.25f * busy * 0.5f;
    }
    float nsw = frac(sin(floor(uDnTime / (45.0f + 60.0f * cellR2) + cellR * 17.0f) * 91.7f + cellR * 311.0f) * 4375.5f); // rooms switch on / off every ~1-2 min
    if (nsw < 0.03f) nOn = 1.0f - nOn;
  }
  float cBl = step(0.72f, cellR2) * min(1.0f, (cellR2 - 0.72f) * 4.0f); // curtain wall: blinds drawn (fraction of the pane)
  // (skyline r12) critic: 'glass slab = one even grid top to bottom'. Tenant zones of 8-15 floors: each zone gets its own
