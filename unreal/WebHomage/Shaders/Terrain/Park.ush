            float2 hp = uMd[i].xy + float2(float(k & 1) * 2.0f - 1.0f,float(k >> 1) * 2.0f - 1.0f) * uMd[i].zw * float2(0.55f + 0.08f * sin(fk * 2.3f),0.5f + 0.08f * cos(fk * 1.7f));
            float2 dir = normalize(uMd[i].xy - hp);                      // outfield points toward the meadow centre
            float ra = 0.35f * sin(fk * 3.1f + 0.4f); dir = float2(dir.x * cos(ra) - dir.y * sin(ra),dir.x * sin(ra) + dir.y * cos(ra));
            float R = 22.0f + 5.0f * frac(fk * 0.618f);
            float2 d = p - hp; float r = length(d), ca = dot(d, dir) / max(r, 1e-3f);
            float fan = (1.0f - smoothstep(R, R + 1.5f, r)) * smoothstep(0.66f, 0.72f, ca);
            float2 q = float2(dot(d, dir),dot(d, float2(-dir.y,dir.x)));  // along / across the foul-line bisector
            float2 qd = float2(q.x + q.y,q.x - q.y) * 0.7071f;             // diamond axes (foul lines)
            float gs = R * 0.64f;
            float grassSq = step(1.5f, qd.x) * step(1.5f, qd.y) * step(qd.x, gs) * step(qd.y, gs);
            float sand = max(fan * (1.0f - grassSq), 1.0f - smoothstep(2.5f, 3.2f, length(q - float2(R * 0.48f,0.0f)))); // + pitcher's mound
            // (park r3) worn infield: darker scuffed base paths / home circle, raked lighter centre, patchy edge into the turf
            float bp = max(1.0f - smoothstep(0.8f, 1.6f, abs(qd.x - 1.0f)), 1.0f - smoothstep(0.8f, 1.6f, abs(qd.y - 1.0f))) * step(qd.x, gs + 2.0f) * step(qd.y, gs + 2.0f) * step(-1.0f, min(qd.x, qd.y));
            float3 dirt = lerp(float3(0.38f,0.27f,0.18f), float3(0.46f,0.34f,0.23f), Texture2DSample(tNoise, tNoiseSampler, fl2(p / 4.0f)).r) * (0.8f + 0.25f * nz2.r); // (park r7) darker compacted clay (critic r6: 'pale decals')
            dirt = lerp(dirt, float3(0.27f,0.2f,0.14f), max(bp * fan, 1.0f - smoothstep(3.0f, 4.5f, r)) * 0.65f);
            sand *= smoothstep(0.25f, 0.6f, Texture2DSample(tNoise, tNoiseSampler, fl2(p / 2.2f)).g + smoothstep(R - 3.0f, R - 0.5f, r) * -0.5f + 0.45f);
            // (park r10) critic r9: 'ballfields are flat decals': a dark lip where the turf edge stands over the skinned
            // infield + a worn, lighter outfield ring in front of it (depth / wear instead of a pasted shape)
            float lip = (1.0f - smoothstep(0.0f, 0.9f, abs(r - R - 0.4f))) * smoothstep(0.64f, 0.72f, ca);
            float worn = (1.0f - smoothstep(R, R + 9.0f, r)) * smoothstep(R - 0.5f, R + 1.5f, r) * smoothstep(0.55f, 0.75f, ca);
            c = lerp(c, c * float3(1.08f,1.03f,0.86f), worn * 0.6f);
            c *= 1.0f - 0.3f * lip;
            c = lerp(c, dirt, clamp(sand, 0.0f, 1.0f) * (0.78f + 0.16f * frac(fk * 0.37f))); // (round 6: worn, not stamped; park r2: sand infields read from the air, refs 08 / 09)
          }
        }
        // pond banks: mud / wet stone ring, then damp dark grass
        float pd = 9.0f; for (int i = 0; i < 5; i++) pd = min(pd, (pondD(TEXPASS, p, uPw[i], uPa[i], uPh[i], uPq[i]) - 1.0f) * max(uPw[i].z, uPw[i].w));
        float bank = 0.0f;
        float3 mud = lerp(float3(0.2f,0.17f,0.13f), float3(0.34f,0.32f,0.29f), step(0.62f, nz2.r)); // mud with stones
        c = lerp(c * (1.0f - 0.35f * (1.0f - smoothstep(3.0f, 9.0f, pd))), mud, bank);
        // (round 5) reeds / shrubby shore vegetation: a patchy dark band a few metres back from the waterline
        float reed = (1.0f - smoothstep(4.0f, 11.0f + 5.0f * nz.g, pd)) * smoothstep(1.5f, 3.5f, pd) * smoothstep(0.35f, 0.6f, nz2.b);
        c = lerp(c, float3(0.09f,0.1f,0.045f) * (0.8f + 0.4f * nz2.g), reed * 0.0f);
        // (round 6) the Reservoir's running track: a cinder / gravel loop ~5-9 m outside the bank, with its iron fence line
        { float rd = (pondD(TEXPASS, p, uPw[3], uPa[3], uPh[3], uPq[3]) - 1.0f) * max(uPw[3].z, uPw[3].w);
          float eg = 0.9f * (Texture2DSample(tNoise, tNoiseSampler, fl2(p / 7.0f)).r - 0.5f);  // (park r9) ragged grass edges, not a clean ruled band
          float trk = smoothstep(4.2f + eg, 5.2f + eg, rd) * (1.0f - smoothstep(8.2f - eg, 9.2f - eg, rd));
          float3 cin = lerp(float3(0.31f,0.26f,0.21f), float3(0.37f,0.31f,0.25f), Texture2DSample(tNoise, tNoiseSampler, fl2(p / 1.7f)).g) * (0.82f + 0.26f * nz2.r); // darker cinder (critic r8: 'clean white band')
          cin *= 1.0f - 0.14f * (1.0f - smoothstep(0.3f, 1.1f, abs(rd - 6.7f + 0.4f * nz.g)));      // worn, compacted running line
          cin = lerp(cin, float3(0.2f,0.18f,0.15f), smoothstep(0.68f, 0.8f, Texture2DSample(tNoise, tNoiseSampler, fl2(p / 13.0f + float2(0.4f,0.1f))).b) * 0.6f); // damp patches
          c = lerp(c, cin, trk * 0.0f);
          c = lerp(c, float3(0.1f,0.1f,0.09f), (1.0f - smoothstep(0.2f, 0.7f, abs(rd - 3.6f))) * 0.0f); }
        return c;
      
}

// shading height field: gentle rolling ground (knolls / hollows of 0.6-1.5 m over 40-160 m), the lawn normal follows it (browser: normal_fragment_maps block)
float TerrainGH(TEXDECL, float2 q) { return Texture2DSampleLevel(tNoise, tNoiseSampler, fl2(q / 160.0f + float2(0.27f, 0.61f)), 0.0f).g * 1.5f + Texture2DSampleLevel(tNoise, tNoiseSampler, fl2(q / 45.0f + float2(0.83f, 0.13f)), 0.0f).r * 0.6f; }
float3 TerrainNormalB(TEXDECL, float2 p) {   // browser-frame normal (y up)
  float e = 3.0f;
  float dx = (TerrainGH(TEXPASS, p + float2(e, 0.0f)) - TerrainGH(TEXPASS, p - float2(e, 0.0f))) / (2.0f * e);
  float dz = (TerrainGH(TEXPASS, p + float2(0.0f, e)) - TerrainGH(TEXPASS, p - float2(0.0f, e))) / (2.0f * e);
  return normalize(float3(-dx * 6.0f, 1.0f, -dz * 6.0f));
}

// UE entry points. wposU = UE world position (cm). rough / nU (UE-frame world normal, mixed 0.85 toward the height-field normal as in the browser).
float3 TerrainParkEntry(TEXDECL, float3 wposU, float lawn, out float rough, out float3 nU)
{
  float2 p = float2(wposU.x, wposU.y) * 0.01f;
  float3 c = lawn > 0.5f ? terrainLawn(TEXPASS, p) : terrainPark(TEXPASS, p);
  float3 nb = normalize(lerp(float3(0.0f, 1.0f, 0.0f), TerrainNormalB(TEXPASS, p), 0.85f));
  nU = CityB2U(nb); rough = 0.95f;
  return c;
}
