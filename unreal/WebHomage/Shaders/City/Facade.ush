    float cxp = fx < bw * 0.5f ? fx / cw : (bw - fx) / cw, cyp = fy < fh * 0.5f ? fy / cw : (fh - fy) / cw;
    al.n = normalize(float3(capX > 0.5f ? (fx < bw * 0.5f ? -1.0f : 1.0f) * (1.0f - clamp(cxp, 0.0f, 1.0f)) * 0.7f : 0.0f,capY > 0.5f ? (fy < fh * 0.5f ? -1.0f : 1.0f) * (1.0f - clamp(cyp, 0.0f, 1.0f)) * 0.35f : 0.0f,1.0f));
    al.rough = capY > 0.5f && capX < 0.5f ? 0.5f : al.rough; // transoms face the sky/sun: brushed, no blown highlight band
    al.emis = ((float3)(0.0f));
    wall.alb = lerp(sp.alb, al.alb, cap); wall.metal = lerp(sp.metal, al.metal, cap); wall.rough = lerp(sp.rough, al.rough, cap);
    wall.n = normalize(lerp(sp.n, al.n, cap));
    // also cap over glass
    win.alb = lerp(win.alb, al.alb, cap); win.metal = lerp(win.metal, al.metal, cap); win.rough = lerp(win.rough, al.rough, cap);
    win.n = normalize(lerp(win.n, al.n, cap)); win.emis *= 1.0f - cap;
  } else if (deco) {
    // dark recessed spandrels between stacked windows -> vertical pier emphasis
    // (skyline r2) cast-aluminium / dark-painted spandrel panels (ESB-like): with the dark glass they read as continuous
    // recessed vertical stripes between the light stone piers; a raised chevron rib every panel catches the light
    float sp = inWx * (1.0f - inWy) * valid;
    float spRib = boxAA(TEXPASS, abs(fy - (fy < wy0 ? wy0 * 0.5f : (wy0 + wh + fh) * 0.5f)), 0.0f, 0.07f, ah);
    Surf sps = o; sps.alb = lerp(float3(0.075f,0.078f,0.082f), float3(0.2f,0.2f,0.19f), 0.35f * frac(seed * 3.3f)) * (0.85f + 0.3f * nz2.r) * (1.0f + 0.9f * spRib);
    sps.metal = 0.22f; sps.rough = 0.62f; sps.n = normalize(float3(0.0f,-0.18f,1.0f)); // (skyline r9) was metal 0.55f + up-tilt: mirrored the sky as blue louvre bands from the street
    wall.alb = lerp(o.alb, sps.alb, sp); wall.n = normalize(lerp(o.n, sps.n, sp)); wall.metal = lerp(o.metal, sps.metal, sp); wall.rough = lerp(o.rough, sps.rough, sp);
    // pier edge shading: piers read as proud of the recessed window/spandrel stripe (light edge / dark edge)
    float pe = boxAA(TEXPASS, fx, wx0 - 0.12f, wx0, aw) - boxAA(TEXPASS, fx, wx0 + ww, wx0 + ww + 0.12f, aw);
    wall.alb *= 1.0f + 0.12f * pe * valid;
  } else {
    // sills & lintels (stone), belt courses, rain streaks
    float3 stone = float3(0.78f,0.75f,0.68f);
    float lint = vX.y;
    float ext = 0.1f;
    float inX = boxAA(TEXPASS, fx, wx0 - ext, wx0 + ww + ext, aw) * valid;
    float sill = inX * boxAA(TEXPASS, fy, wy0 - 0.12f, wy0, ah);
    float head = inX * boxAA(TEXPASS, fy, wy0 + wh, wy0 + wh + (lint > 1.5f ? 0.35f : 0.22f), ah);
    if (zArch > 0.5f) { // (street r9) arched head: stone voussoir ring + keystone instead of a flat lintel
      float ar = ww * 0.5f, acy = wy0 + wh - ar; float2 dq = float2(fx - wx0 - ar,fy - acy);
      float rr = length(dq);
      head = step(0.0f, dq.y) * (smoothstep(ar - aw, ar + aw, rr) - smoothstep(ar + 0.26f - aw, ar + 0.26f + aw, rr));
      head = max(head, boxAA(TEXPASS, abs(dq.x), -1.0f, 0.13f, aw) * boxAA(TEXPASS, fy, wy0 + wh - 0.05f, wy0 + wh + 0.36f, ah));
      head *= valid;
      lint = max(lint, 1.0f);
    }
    if (zMidF) { head = inX * boxAA(TEXPASS, fy, wy0 + wh, wy0 + wh + 0.42f, ah); sill = inX * boxAA(TEXPASS, fy, wy0 - 0.2f, wy0, ah); lint = max(lint, 2.0f); } // (street r11) dressed floor over a mid belt
    if (zInBase) head = 0.0f; // rusticated base: the stone joints frame the openings
    // (textures r2) under-sill soot / rain runs from the $imagegen grime decal sheet (was a 1.4f m gradient box): each window
    // picks one of 24 streak shapes and a 0.8f-3 m run; above the window head the run of the floor above continues
    float gdy = wy0 - 0.12f - fy, gcr = cellR;
    if (gdy < 0.0f) { gdy += fh; gcr = fh1(TEXPASS, float2(bi + seed * 3.7f,fl + 1.0f + seed * 1.3f)); }
    float gLn = 0.8f + 2.2f * frac(gcr * 3.3f), gWd = ww + 0.35f;
    float streak = grimeDecal(TEXPASS, float2((fx - wx0 + 0.175f) / gWd,gdy / gLn), float2(1.0f / gWd,1.0f / gLn), floor(frac(gcr * 5.1f) * 24.0f)) * valid * 0.42f;
    if (pOK) streak *= 0.45f + 1.1f * frac(gcr * 5.1f); // (street r11) grime under sills varies per window (some heavy runs)
    wall.alb *= 1.0f - streak;
    float belt = 0.0f;
    if (fl < 0.5f) belt = boxAA(TEXPASS, fy, -0.01f, 0.35f, ah); // belt course above storefront
    belt = max(belt, boxAA(TEXPASS, yy - (topY - gH - 1.2f), 0.0f, 0.4f, ah)) * boxAA(TEXPASS, ux, -margin - 1.0f, usable + margin + 1.0f, aw);
    if (zOK) { // (street r9) zone belt courses (base top / cap bottom) with a shadow line under each, sill courses every N floors
      float zb = 0.0f, zs = 0.0f;
      if (zBase > 0.0f) { zb = max(zb, boxAA(TEXPASS, yy, zBase * fh - 0.02f, zBase * fh + 0.46f, ah)); zs = max(zs, boxAA(TEXPASS, yy, zBase * fh - 0.2f, zBase * fh - 0.02f, ah)); }
      if (zCap > 0.0f) { zb = max(zb, boxAA(TEXPASS, yy, zCapY - 0.38f, zCapY + 0.02f, ah)); zs = max(zs, boxAA(TEXPASS, yy, zCapY - 0.52f, zCapY - 0.38f, ah)); }
      float strN = zH3 < 0.3f ? 0.0f : 2.0f + floor(zH3 * 4.0f);
      if (strN > 0.5f && !zInBase && !zInCap && gmod(fl, strN) < 0.5f) zb = max(zb, boxAA(TEXPASS, fy, wy0 - 0.15f, wy0, ah));
      // (street r11) critic: 'a single window module tiled over 15+ floors, no mid-cornice'. Tall shafts get a heavy
      // stone belt course every zMidK (6-8) floors (buildings.js zoneBelts emits the matching projecting ledge), with a
      // cast shadow under it and the floor above it in stone-dressed windows (lintel + sill, see zMidF)
      if (zMidK > 0.5f && !zInBase && !zInCap) {
        float bj = floor((yy / fh - zBase) / zMidK + 0.5f), bF = zBase + bj * zMidK;
        if (bj >= 1.0f && bF <= zNf - zCap - 3.0f) {
          zb = max(zb, boxAA(TEXPASS, yy, bF * fh - 0.02f, bF * fh + 0.5f, ah));
          zs = max(zs, boxAA(TEXPASS, yy, bF * fh - 0.34f, bF * fh - 0.02f, ah));
        }
      }
      wall.alb *= 1.0f - 0.45f * zs * (1.0f - zb);
      belt = max(belt, zb);
    } else if (zMidK > 0.5f) { // (street r11) mid-shaft belt courses on the other punched walls (concrete / granite / white)
      float bj = floor(yy / fh / zMidK + 0.5f), bF = bj * zMidK, zb = 0.0f, zs = 0.0f;
      if (bj >= 1.0f && bF <= zNf - 3.0f) { zb = boxAA(TEXPASS, yy, bF * fh - 0.02f, bF * fh + 0.5f, ah); zs = boxAA(TEXPASS, yy, bF * fh - 0.34f, bF * fh - 0.02f, ah); }
      wall.alb *= 1.0f - 0.45f * zs * (1.0f - zb);
      belt = max(belt, zb);
    }
    float st = max(max(sill, head), belt);
    Surf ss = wallSurf(TEXPASS, float2(u,vFac.y), 3.0f, ((float3)(1.0f)));
    ss.alb *= stone * 1.25f;
    ss.n = normalize(float3(0.0f,sill > 0.5f ? 0.7f : (head > 0.5f ? -0.25f : 0.2f),1.0f));
    if (lint > 0.5f || belt > 0.5f) {
      wall.alb = lerp(wall.alb, ss.alb, st); wall.n = normalize(lerp(wall.n, ss.n, st)); wall.rough = lerp(wall.rough, 0.8f, st);
    } else { // soldier course (darker brick header)
      wall.alb *= 1.0f - 0.18f * head;
      wall.alb = lerp(wall.alb, ss.alb, sill);
    }
  }
  // AO-ish darkening around openings
  wall.alb *= 1.0f - 0.1f * (inWx * boxAA(TEXPASS, fy, wy0 - 0.3f, wy0 + wh + 0.3f, ah)) * (1.0f - open);

  Surf r = (Surf)0;
  r.alb = lerp(wall.alb, win.alb, open); r.rough = lerp(wall.rough, win.rough, open); r.metal = lerp(wall.metal, win.metal, open);
  r.n = normalize(lerp(wall.n, win.n, open)); r.emis = win.emis * open;
  float capW = 0.0f;
  if (curtain) capW = max(1.0f - boxAA(TEXPASS, fx, cw, bw - cw, aw), 1.0f - boxAA(TEXPASS, fy, cw, fh - cw, ah));
  gGlass = open * inG * (1.0f - frame) * (1.0f - capW);
  if (curtain) gGlass = max(gGlass, (1.0f - open) * (1.0f - capW) * spGl * 0.8f); // shadow-box spandrel glass reflects too
  gF0 = curtain ? (lowIron ? 0.46f : (gsel > 5.5f ? 0.62f : (gsel > 4.5f ? 0.2f : 0.25f))) * (0.85f + 0.3f * frac(seed * 6.83f + 0.37f)) : 0.12f; // (skyline r12) per-tower coating: mirror 0.62f, tinted 0.2f, +-15 % per tower // (skyline r7) low-iron supertall glass 0.34f -> 0.46f (One WTC reads bright) // (skyline r6) 0.2f -> 0.25f: glass reads as glass
  if (pOK && !zOK) { gF0 = 0.085f; gSash = 1.0f; } // (textures r4) 0.05f -> 0.085f: sash glass mirrors the sky / street opposite // (street r10) all punched walls: dusty, dim sash glass
  if (curtain && vX.y > 2.5f) { gF0 = 0.03f; gSash = 1.0f; gSashV = 0.5f; } // (street r11) lintel 3 on a curtain wall = dark mechanical louvre band (MetLife plant floors)
  if (zOK) {
    // (street r9) old sash glass: dusty, lower grazing reflectance (critic: 'windows read as flat bright white-grey planes')
    gF0 = 0.085f; gSash = 1.0f; // (street r10) 0.07f -> 0.05f // (textures r4) -> 0.085f (critic r3: 'windows flat black holes, no glass')
    // (street r9) through-window AC units: a 0.28f m deep box sitting on the sill (front face / top / side by ray-marching
    // the view segment through the box at 3 depths), a shadow + condensate drip stain on the wall below
    float acRate = (resid ? 0.2f : 0.09f) * (zInBase ? 0.3f : 1.0f) * step(0.15f, frac(seed * 6.61f));
    float cR3 = fh1(TEXPASS, float2(bi * 3.1f + seed * 0.71f,fl * 5.7f - seed * 0.3f));
    if (cR3 < acRate && valid > 0.5f && lod < 0.99f) {
      float acW = min(0.72f, ww - 0.1f), acH = 0.42f, acD = 0.3f, cx = wx0 + 0.5f * ww + (frac(cR3 * 37.0f) - 0.5f) * max(ww - acW - 0.1f, 0.0f);
      float2 sh = float2(Vt.x,Vt.y) / Vt.z * acD;
      float2 p0 = float2(fx,fy), p1 = p0 + sh, pm = p0 + 0.5f * sh;
      float m0 = boxAA(TEXPASS, p0.x, cx - 0.5f * acW, cx + 0.5f * acW, aw) * boxAA(TEXPASS, p0.y, wy0, wy0 + acH, ah);
      float mm = boxAA(TEXPASS, pm.x, cx - 0.5f * acW, cx + 0.5f * acW, aw) * boxAA(TEXPASS, pm.y, wy0, wy0 + acH, ah);
      float m1 = boxAA(TEXPASS, p1.x, cx - 0.5f * acW, cx + 0.5f * acW, aw) * boxAA(TEXPASS, p1.y, wy0, wy0 + acH, ah);
      float hit = max(max(m0, mm), m1);
      if (hit > 0.0f) {
        float gy = (p1.y - wy0) / acH;
        float3 acC = lerp(float3(0.62f,0.61f,0.57f), float3(0.5f,0.52f,0.52f), step(0.5f, frac(cR3 * 91.0f))) * (0.85f + 0.2f * nz2.r);
        float gr = step(0.5f, frac(gy * 7.0f)) * step(0.35f, gy) * step(gy, 0.92f);   // front grille slots
        Surf ac = (Surf)0; ac.metal = 0.3f; ac.rough = 0.55f; ac.emis = ((float3)(0.0f));
        if (m1 > 0.5f) { ac.alb = acC * (1.0f - 0.3f * gr); ac.n = float3(0.0f,0.0f,1.0f); }
        else if (p1.y > wy0 + acH) { ac.alb = acC * 1.1f; ac.n = float3(0.0f,1.0f,0.15f); }           // top face
        else if (p1.y < wy0) { ac.alb = acC * 0.4f; ac.n = float3(0.0f,-1.0f,0.15f); }                // underside
        else { ac.alb = acC * 0.8f; ac.n = float3(p1.x < cx ? -1.0f : 1.0f,0.0f,0.2f); }               // side
        ac.n = normalize(ac.n);
